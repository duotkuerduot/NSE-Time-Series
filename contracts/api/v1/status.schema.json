{
  "$defs": {
    "DatasetInfo": {
      "additionalProperties": false,
      "description": "Where the data came from, for the header, footer and About page (v1.1).",
      "properties": {
        "source": {
          "enum": [
            "mendeley",
            "local",
            "sample"
          ],
          "title": "Source",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "version": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Version"
        },
        "first_session": {
          "format": "date",
          "title": "First Session",
          "type": "string"
        },
        "last_session": {
          "format": "date",
          "title": "Last Session",
          "type": "string"
        },
        "licence": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Licence"
        },
        "citation": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Citation"
        },
        "doi": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Doi"
        },
        "url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Url"
        }
      },
      "required": [
        "source",
        "title",
        "version",
        "first_session",
        "last_session",
        "licence",
        "citation",
        "doi",
        "url"
      ],
      "title": "DatasetInfo",
      "type": "object"
    },
    "ModelRef": {
      "additionalProperties": false,
      "properties": {
        "model_id": {
          "title": "Model Id",
          "type": "string"
        },
        "label": {
          "description": "Display name, e.g. 'LightGBM' or 'No-change baseline'",
          "title": "Label",
          "type": "string"
        },
        "version": {
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "model_id",
        "label",
        "version"
      ],
      "title": "ModelRef",
      "type": "object"
    },
    "Notice": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "severity": {
          "default": "info",
          "enum": [
            "info",
            "warning"
          ],
          "title": "Severity",
          "type": "string"
        }
      },
      "required": [
        "code",
        "message",
        "severity"
      ],
      "title": "Notice",
      "type": "object"
    },
    "PipelineStatus": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "succeeded",
            "failed",
            "running",
            "data_not_yet_available",
            "quarantined",
            "skipped"
          ],
          "title": "Status",
          "type": "string"
        },
        "finished_at": {
          "anyOf": [
            {
              "description": "ISO 8601 with offset, e.g. ...Z",
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Finished At"
        },
        "primary_source": {
          "enum": [
            "mendeley",
            "local",
            "sample"
          ],
          "title": "Primary Source",
          "type": "string"
        },
        "fallback_used": {
          "description": "Always false in local mode",
          "title": "Fallback Used",
          "type": "boolean"
        },
        "dq": {
          "enum": [
            "passed",
            "held",
            "failed",
            "not_run"
          ],
          "title": "Dq",
          "type": "string"
        }
      },
      "required": [
        "status",
        "finished_at",
        "primary_source",
        "fallback_used",
        "dq"
      ],
      "title": "PipelineStatus",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Pointer to the current release, plus run and data status.",
  "properties": {
    "api_version": {
      "const": "1",
      "default": "1",
      "title": "Api Version",
      "type": "string"
    },
    "contract_version": {
      "const": "1.1",
      "default": "1.1",
      "title": "Contract Version",
      "type": "string"
    },
    "release_id": {
      "pattern": "^\\d{4}-\\d{2}-\\d{2}\\.[0-9a-f]{7,64}$",
      "title": "Release Id",
      "type": "string"
    },
    "generated_at": {
      "description": "ISO 8601 with offset, e.g. ...Z",
      "format": "date-time",
      "title": "Generated At",
      "type": "string"
    },
    "latest_session": {
      "format": "date",
      "title": "Latest Session",
      "type": "string"
    },
    "next_session": {
      "format": "date",
      "title": "Next Session",
      "type": "string"
    },
    "stale_after": {
      "anyOf": [
        {
          "description": "ISO 8601 with offset, e.g. ...Z",
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "description": "When the next release is due; null in local mode, where data is never late",
      "title": "Stale After"
    },
    "data_mode": {
      "enum": [
        "historical",
        "historical+imports",
        "sample"
      ],
      "title": "Data Mode",
      "type": "string"
    },
    "dataset": {
      "$ref": "#/$defs/DatasetInfo"
    },
    "pipeline": {
      "$ref": "#/$defs/PipelineStatus"
    },
    "champion": {
      "anyOf": [
        {
          "$ref": "#/$defs/ModelRef"
        },
        {
          "type": "null"
        }
      ]
    },
    "notices": {
      "items": {
        "$ref": "#/$defs/Notice"
      },
      "title": "Notices",
      "type": "array"
    }
  },
  "required": [
    "api_version",
    "contract_version",
    "release_id",
    "generated_at",
    "latest_session",
    "next_session",
    "stale_after",
    "data_mode",
    "dataset",
    "pipeline",
    "champion",
    "notices"
  ],
  "title": "Status",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/duotkuerduot/NSE-Time-Series/contracts/api/v1/status.schema.json"
}
