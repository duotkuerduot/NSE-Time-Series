# Names of the environment variables nsefc reads. Values live in GitHub environment
# secrets (production, dryrun) or in a local, git-ignored .env. Never commit values.

# Which configuration layer to load: development | ci | dryrun | production
NSEFC_ENV=development

# Cloudflare R2 (pipeline token: read/write on nsefc-data and nsefc-public only)
NSEFC_R2_ACCOUNT_ID=
NSEFC_R2_ACCESS_KEY_ID=
NSEFC_R2_SECRET_ACCESS_KEY=

# Dead-man's switch base URL (healthchecks.io)
NSEFC_HEALTHCHECK_URL=

# Any setting can be overridden as NSEFC__SECTION__KEY, for example:
# NSEFC__PIPELINE__FRESHNESS_DEADLINE_EAT=22:00
