.import_linter_cache/
.coverage
htmlcov/
dist/
build/
*.egg-info/

# Web (the built app is committed in src/nsefc/web_dist instead)
web/node_modules/
web/dist/
web/coverage/
web/playwright-report/
web/test-results/

